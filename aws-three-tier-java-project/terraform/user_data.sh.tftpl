#!/bin/bash
set -euxo pipefail
dnf update -y
dnf install -y java-17-amazon-corretto-headless git maven amazon-cloudwatch-agent
mkdir -p /opt/cloud-demo
cd /opt/cloud-demo
git clone --depth 1 --branch ${application_branch} ${application_repo_url} source
cd source/app
mvn -B clean package -DskipTests
cat > /etc/systemd/system/cloud-demo.service <<SERVICE
[Unit]
Description=AWS Three Tier Spring Boot Application
After=network-online.target
Wants=network-online.target
[Service]
User=root
WorkingDirectory=/opt/cloud-demo/source/app
Environment=DB_SECRET_ARN=${secret_arn}
Environment=AWS_REGION=${aws_region}
ExecStart=/usr/bin/java -jar /opt/cloud-demo/source/app/target/aws-three-tier-java-1.0.0.jar
Restart=always
RestartSec=10
StandardOutput=append:/var/log/cloud-demo.log
StandardError=append:/var/log/cloud-demo.log
[Install]
WantedBy=multi-user.target
SERVICE
systemctl daemon-reload
systemctl enable --now cloud-demo
cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'CW'
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/cloud-demo.log",
            "log_group_name": "${log_group}",
            "log_stream_name": "{instance_id}/application",
            "retention_in_days": 7
          }
        ]
      }
    }
  }
}
CW
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json -s || true
